NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://vendo:change_me@localhost:5432/vendo?schema=public
SHADOW_DATABASE_URL=postgresql://vendo:change_me@localhost:5432/vendo_shadow?schema=public
POSTGRES_DB=vendo
POSTGRES_USER=vendo
POSTGRES_PASSWORD=change_me
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ISSUER=vendo-api
JWT_AUDIENCE=vendo-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TTL=30m
CORS_ORIGINS=http://localhost:3000
APP_CURRENCY=BDT
APP_TIMEZONE=Asia/Dhaka
ALLOW_DEV_BOOTSTRAP=false
BOOTSTRAP_COMPANY_CODE=
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

model Payment {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @db.Uuid
  branchId            String            @db.Uuid
  methodId            String            @db.Uuid
  customerId          String?           @db.Uuid
  supplierId          String?           @db.Uuid
  recordedById        String            @db.Uuid
  paymentNumber       String            @db.VarChar(60)
  direction           PaymentDirection
  status              PaymentStatus     @default(COMPLETED)
  amount              Decimal           @db.Decimal(19, 4)
  reference           String?           @db.VarChar(160)
  paidAt              DateTime          @default(now()) @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  branch              Branch            @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  method              PaymentMethod     @relation(fields: [methodId, companyId], references: [id, companyId], onDelete: Restrict)
  customer            Customer?         @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  supplier            Supplier?         @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  recordedBy          User              @relation("PaymentRecordedBy", fields: [recordedById, companyId], references: [id, companyId], onDelete: Restrict)
  saleAllocations     SalePayment[]
  purchaseAllocations PurchasePayment[]
  cashMovements       CashMovement[]

  @@unique([companyId, paymentNumber])
  @@unique([id, companyId])
  @@index([companyId, branchId, paidAt])
  @@index([companyId, customerId, paidAt])
  @@index([companyId, supplierId, paidAt])
}

model SalePayment {

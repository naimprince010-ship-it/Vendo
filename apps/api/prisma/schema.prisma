  unitId              String                @db.Uuid
  createdById         String                @db.Uuid
  type                InventoryMovementType
  baseQuantity        Decimal               @db.Decimal(20, 6)
  transactionQuantity Decimal               @db.Decimal(20, 6)
  conversionFactor    Decimal               @db.Decimal(24, 10)
  unitCost            Decimal?              @db.Decimal(19, 4)
  referenceType       String                @db.VarChar(60)

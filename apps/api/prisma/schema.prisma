generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ProductType {
  TILE
  SANITARY
  ACCESSORY
  GENERAL
}

enum PriceType {
  RETAIL
  WHOLESALE
  MINIMUM
  CUSTOM
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  POSTED
  VOIDED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum SaleStatus {
  DRAFT
  HELD
  COMPLETED
  VOIDED
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
}

enum InventoryMovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  DAMAGE
  LOSS
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_RECONCILIATION
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  CASH_SALE
  CASH_REFUND
  CASH_IN
  CASH_OUT
  EXPENSE
  CLOSING_ADJUSTMENT
}

enum SettingScope {
  COMPANY
  BRANCH
}

model Company {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique @db.VarChar(40)
  name                 String   @db.VarChar(160)
  legalName            String?  @db.VarChar(200)
  phone                String?  @db.VarChar(40)
  email                String?  @db.VarChar(254)
  address              String?
  countryCode          String   @default("BD") @db.Char(2)
  currencyCode         String   @default("BDT") @db.Char(3)
  timezone             String   @default("Asia/Dhaka") @db.VarChar(80)
  negativeStockAllowed Boolean  @default(false)
  quantityScale        Int      @default(6)
  moneyScale           Int      @default(4)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  branches            Branch[]
  users               User[]
  roles               Role[]
  units               Unit[]
  categories          Category[]
  brands              Brand[]
  manufacturers       Manufacturer[]
  products            Product[]
  customerGroups      CustomerGroup[]
  customers           Customer[]
  suppliers           Supplier[]
  paymentMethods      PaymentMethod[]
  expenseCategories   ExpenseCategory[]
  settings            Setting[]
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@unique([id, code])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(160)
  phone     String?  @db.VarChar(40)
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouses         Warehouse[]
  registers          Register[]
  userBranches       UserBranch[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  purchaseInvoices   PurchaseInvoice[]
  sales              Sale[]
  payments           Payment[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]
  expenses           Expense[]
  inventoryMovements InventoryMovement[]
  settings           Setting[]
  auditLogs          AuditLog[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, isActive])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  branchId  String   @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branch             Branch              @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@unique([id, branchId, companyId])
  @@index([branchId, isActive])
}

model Register {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  branchId  String   @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branch     Branch      @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  sales      Sale[]
  cashShifts CashShift[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@unique([id, branchId, companyId])
  @@index([branchId, isActive])
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @db.Uuid
  email             String     @db.VarChar(254)
  passwordHash      String     @db.VarChar(255)
  firstName         String     @db.VarChar(100)
  lastName          String?    @db.VarChar(100)
  phone             String?    @db.VarChar(40)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @db.Timestamptz(3)
  lastFailedLoginAt DateTime?  @db.Timestamptz(3)
  lockedUntil       DateTime?  @db.Timestamptz(3)
  failedLoginCount  Int        @default(0)
  credentialVersion Int        @default(0)
  passwordChangedAt DateTime   @default(now()) @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles           UserRole[]
  userBranches        UserBranch[]
  purchaseOrders      PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  goodsReceipts       GoodsReceipt[]       @relation("GoodsReceiptReceivedBy")
  sales               Sale[]               @relation("SaleCreatedBy")
  payments            Payment[]            @relation("PaymentRecordedBy")
  cashShifts          CashShift[]          @relation("CashShiftCashier")
  cashMovements       CashMovement[]       @relation("CashMovementRecordedBy")
  expenses            Expense[]            @relation("ExpenseCreatedBy")
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  auditLogs           AuditLog[]           @relation("AuditActor")
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@unique([companyId, email])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokeReason     String?   @db.VarChar(120)
  replacedById     String?   @db.Uuid
  ipAddress        String?   @db.Inet
  userAgent        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User         @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  replacedBy AuthSession? @relation("AuthSessionRotation", fields: [replacedById, companyId], references: [id, companyId], onDelete: Restrict)
  replaces   AuthSession? @relation("AuthSessionRotation")

  @@unique([id, companyId])
  @@unique([replacedById, companyId])
  @@index([companyId, userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  ipAddress String?   @db.Inet
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  key         String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, key])
  @@unique([id, companyId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
}

model RolePermission {
  companyId    String     @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([companyId, permissionId])
}

model UserRole {
  companyId String @db.Uuid
  userId    String @db.Uuid
  roleId    String @db.Uuid
  user      User   @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  role      Role   @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([companyId, roleId])
}

model UserBranch {
  companyId String @db.Uuid
  userId    String @db.Uuid
  branchId  String @db.Uuid
  user      User   @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([companyId, branchId])
}

model Unit {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  code                 String                @db.VarChar(24)
  name                 String                @db.VarChar(80)
  decimalScale         Int                   @default(6)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products             Product[]             @relation("ProductBaseUnit")
  conversions          UnitConversion[]
  prices               ProductPrice[]
  barcodes             ProductBarcode[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  saleItems            SaleItem[]
  inventoryMovements   InventoryMovement[]

  @@unique([companyId, code])
  @@unique([id, companyId])
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid
  parentId  String?    @db.Uuid
  name      String     @db.VarChar(120)
  slug      String     @db.VarChar(140)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent    Category?  @relation("CategoryTree", fields: [parentId, companyId], references: [id, companyId], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@unique([companyId, slug])
  @@unique([id, companyId])
  @@index([companyId, parentId, isActive])
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @db.VarChar(140)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([companyId, slug])
  @@unique([id, companyId])
  @@index([companyId, name, isActive])
}

model Manufacturer {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  name      String    @db.VarChar(160)
  slug      String    @db.VarChar(180)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products  Product[]

  @@unique([companyId, slug])
  @@unique([id, companyId])
  @@index([companyId, name, isActive])
}

model Product {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @db.Uuid
  categoryId           String?                 @db.Uuid
  brandId              String?                 @db.Uuid
  manufacturerId       String?                 @db.Uuid
  baseUnitId           String                  @db.Uuid
  type                 ProductType
  sku                  String                  @db.VarChar(80)
  name                 String                  @db.VarChar(200)
  model                String?                 @db.VarChar(120)
  description          String?
  standardCost         Decimal?                @db.Decimal(19, 4)
  reorderLevel         Decimal?                @db.Decimal(20, 6)
  trackInventory       Boolean                 @default(true)
  batchTracking        Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category             Category?               @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  brand                Brand?                  @relation(fields: [brandId, companyId], references: [id, companyId], onDelete: Restrict)
  manufacturer         Manufacturer?           @relation(fields: [manufacturerId, companyId], references: [id, companyId], onDelete: Restrict)
  baseUnit             Unit                    @relation("ProductBaseUnit", fields: [baseUnitId, companyId], references: [id, companyId], onDelete: Restrict)
  tileProfile          ProductTileProfile?
  sanitaryProfile      ProductSanitaryProfile?
  barcodes             ProductBarcode[]
  conversions          UnitConversion[]
  prices               ProductPrice[]
  batches              ProductBatch[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  saleItems            SaleItem[]
  inventoryMovements   InventoryMovement[]
  inventoryBalances    InventoryBalance[]

  @@unique([companyId, sku])
  @@unique([id, companyId])
  @@index([companyId, name])
  @@index([companyId, model])
  @@index([companyId, brandId, isActive])
  @@index([companyId, manufacturerId, isActive])
  @@index([companyId, categoryId, isActive])
}

model ProductTileProfile {
  productId       String   @id @db.Uuid
  companyId       String   @db.Uuid
  widthMm         Decimal  @db.Decimal(12, 3)
  heightMm        Decimal  @db.Decimal(12, 3)
  thicknessMm     Decimal? @db.Decimal(10, 3)
  displaySize     String?  @db.VarChar(80)
  series          String?  @db.VarChar(120)
  finish          String?  @db.VarChar(80)
  surface         String?  @db.VarChar(80)
  color           String?  @db.VarChar(80)
  grade           String?  @db.VarChar(40)
  countryOfOrigin String?  @db.Char(2)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  product         Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([productId, companyId])
  @@index([companyId, widthMm, heightMm])
  @@index([companyId, series])
}

model ProductSanitaryProfile {
  productId       String   @id @db.Uuid
  companyId       String   @db.Uuid
  size            String?  @db.VarChar(100)
  color           String?  @db.VarChar(80)
  material        String?  @db.VarChar(100)
  finish          String?  @db.VarChar(80)
  warrantyMonths  Int?
  warrantyDetails String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  product         Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([productId, companyId])
  @@index([companyId, material])
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  productId String   @db.Uuid
  unitId    String?  @db.Uuid
  barcode   String   @db.VarChar(120)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, barcode])
  @@index([productId])
}

model UnitConversion {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  productId    String   @db.Uuid
  fromUnitId   String   @db.Uuid
  factorToBase Decimal  @db.Decimal(24, 10)
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  product      Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  fromUnit     Unit     @relation(fields: [fromUnitId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, productId, fromUnitId, version])
  @@index([companyId, productId, isActive])
}

model ProductPrice {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  productId String    @db.Uuid
  unitId    String    @db.Uuid
  type      PriceType
  amount    Decimal   @db.Decimal(19, 4)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  product   Product   @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  unit      Unit      @relation(fields: [unitId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([companyId, productId, unitId, type])
  @@index([companyId, productId, isActive])
}

model ProductBatch {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  productId          String              @db.Uuid
  supplierId         String?             @db.Uuid
  batchNumber        String              @db.VarChar(100)
  lotNumber          String?             @db.VarChar(100)
  shade              String?             @db.VarChar(80)
  receivedAt         DateTime?           @db.Timestamptz(3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  product            Product             @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  supplier           Supplier?           @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  goodsReceiptItems  GoodsReceiptItem[]
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]

  @@unique([id, companyId])
  @@unique([id, productId, companyId])
  @@index([companyId, productId, batchNumber, lotNumber, shade])
  @@index([companyId, productId, isActive])
}

model CustomerGroup {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid
  name      String     @db.VarChar(120)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customers Customer[]

  @@unique([companyId, name])
  @@unique([id, companyId])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  groupId        String?        @db.Uuid
  code           String         @db.VarChar(50)
  name           String         @db.VarChar(160)
  phone          String?        @db.VarChar(40)
  email          String?        @db.VarChar(254)
  address        String?
  creditLimit    Decimal        @default(0) @db.Decimal(19, 4)
  openingBalance Decimal        @default(0) @db.Decimal(19, 4)
  isWalkIn       Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  group          CustomerGroup? @relation(fields: [groupId, companyId], references: [id, companyId], onDelete: Restrict)
  sales          Sale[]
  payments       Payment[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, phone])
  @@index([companyId, name])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  code             String            @db.VarChar(50)
  name             String            @db.VarChar(160)
  contactName      String?           @db.VarChar(120)
  phone            String?           @db.VarChar(40)
  email            String?           @db.VarChar(254)
  address          String?
  openingBalance   Decimal           @default(0) @db.Decimal(19, 4)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  batches          ProductBatch[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  payments         Payment[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, phone])
  @@index([companyId, name])
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  branchId    String              @db.Uuid
  warehouseId String              @db.Uuid
  supplierId  String              @db.Uuid
  createdById String              @db.Uuid
  orderNumber String              @db.VarChar(60)
  status      OrderStatus         @default(DRAFT)
  orderDate   DateTime            @db.Date
  expectedAt  DateTime?           @db.Date
  subtotal    Decimal             @default(0) @db.Decimal(19, 4)
  discount    Decimal             @default(0) @db.Decimal(19, 4)
  tax         Decimal             @default(0) @db.Decimal(19, 4)
  freight     Decimal             @default(0) @db.Decimal(19, 4)
  total       Decimal             @default(0) @db.Decimal(19, 4)
  notes       String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

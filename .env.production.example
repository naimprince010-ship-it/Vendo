APP_DOMAIN=pos.example.com
POSTGRES_DB=vendo
POSTGRES_USER=vendo
POSTGRES_PASSWORD=generate_a_long_random_database_password
DATABASE_URL=postgresql://vendo:URL_ENCODED_PASSWORD@postgres:5432/vendo?schema=public
JWT_ACCESS_SECRET=generate_a_distinct_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=generate_another_distinct_random_secret_of_at_least_32_characters
JWT_ISSUER=vendo-api
JWT_AUDIENCE=vendo-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_RESET_TTL=30m
